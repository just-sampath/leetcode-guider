{
    "manifest_version": 3,
    "name": "LeetCode AI Coach",
    "version": "1.0.0",
    "description": "AI-powered coaching assistant for LeetCode problems. BYOK support for OpenAI, Anthropic, Google Gemini, and custom providers.",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://leetcode.com/*",
        "https://api.openai.com/*",
        "https://api.anthropic.com/*",
        "https://generativelanguage.googleapis.com/*"
    ],
    "background": {
        "service_worker": "background/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/problems/*"
            ],
            "js": [
                "content/EventBus.js",
                "content/LeetCodeDomAdapter.js",
                "content/CodeBridge.js",
                "content/UiPanel.js",
                "content/contentScript.js"
            ],
            "css": [
                "panel/panel.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "page/injectedPageScript.js"
            ],
            "matches": [
                "https://leetcode.com/*"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        },
        "default_title": "LeetCode AI Coach Settings"
    }
}